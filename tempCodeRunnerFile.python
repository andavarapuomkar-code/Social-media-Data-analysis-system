df["Platform"].value_counts().plot(kind="pie", autopct="%1.1f%%", startangle=90)
plt.title("Platform Distribution")
plt.ylabel("")
plt.show()


# Visualization: show the proportion of posts in each topic category.
df["Category"].value_counts().plot(kind="pie", autopct="%1.1f%%", startangle=90)
plt.title("Posts by Category")
plt.ylabel("")
plt.show()


# Visualization: compare counts of Positive, Negative, and Neutral posts.
df["Sentiment"].value_counts().plot(kind="bar")
plt.title("Sentiment Distribution")
plt.xlabel("Sentiment")
plt.ylabel("Number of Posts")
plt.xticks(rotation=0)
plt.tight_layout()
plt.show()


# Visualization: show the percentage distribution of sentiment labels.
df["Sentiment"].value_counts().plot(kind="pie", autopct="%1.1f%%", startangle=90)
plt.title("Sentiment Distribution")
plt.ylabel("")
plt.show()


# Visualization: compare average engagement across topic categories.
engagement_by_category = df.groupby("Category")["Total_Engagement"].mean()
engagement_by_category.plot(kind="bar")
plt.title("Average Engagement by Category")
plt.xlabel("Category")
plt.ylabel("Average Engagement")
plt.xticks(rotation=45)
plt.tight_layout()
plt.show()
# Save the processed data and all newly created analysis columns.
# Save the analyzed dataset
df.to_csv("social_media_analyzed.csv", index=False)

print("Analyzed dataset saved successfully!")

# Download the CSV file
files.download("social_media_analyzed.csv")
                        
